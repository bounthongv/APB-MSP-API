# APB Sync Service - Environment Configuration
# Copy this to .env and fill in real values

# ─── LOCAL MYSQL (Source - where APB API stores transactions) ───
DB_HOST=localhost
DB_USER=msp_user
DB_PASSWORD=msp_password
DB_NAME=apb_msp

# ─── REMOTE MSSQL (Destination - APB Accounting DB) ───
MSSQL_HOST=10.151.146.90
MSSQL_DB=FN_APB2025
MSSQL_USER=sa
MSSQL_PASSWORD=Apb@2k25
MSSQL_DRIVER={ODBC Driver 18 for SQL Server}

# ─── FIXED CONSTANTS ───
# Office_ID confirmed with APB as "01-02"
OFFICE_ID=01-02
USER_ID=API_BOT

# ─── RETRY SETTINGS ───
# Log file path (structured logging with timestamps)
SYNC_LOG=/var/log/apb_sync.log

# How long to keep retrying a failed transaction (default: 86400 = 24 hours)
# After this, a visible ALERT line is written to the log.
SYNC_RETRY_WINDOW=86400